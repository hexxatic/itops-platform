# Copy to .env for local development. Never commit .env.
ITOPS_ENV=development
ITOPS_AUTH_MODE=dev
# SQL Server with Windows authentication: no password anywhere.
# Dev: the local Developer Edition instance. Production: a named instance (SERVER\INSTANCE) or host,port.
ITOPS_DB_SERVER=localhost
ITOPS_DB_NAME=itops
# AI tier 2 (local embeddings) and tier 3 (embedded LLM): both "none" until chosen.
ITOPS_AI_EMBEDDINGS_PROVIDER=none
ITOPS_AI_LLM_PROVIDER=none
# Entra ID sign-in (app registration "IT-Ops"). The secret goes in .env only.
# ITOPS_AUTH_MODE=entra
# ITOPS_ENTRA_TENANT_ID=
# ITOPS_ENTRA_CLIENT_ID=
# ITOPS_ENTRA_CLIENT_SECRET=
# Signs the session cookie; required in production (python -c "import secrets; print(secrets.token_urlsafe(32))").
# ITOPS_SECRET_KEY=
